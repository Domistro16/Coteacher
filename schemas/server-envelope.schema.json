{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["algorithm", "iv", "tag", "ciphertext"],
  "properties": {
    "algorithm": { "const": "aes-256-gcm-server-v1" },
    "iv": { "type": "string", "minLength": 16, "maxLength": 16, "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
    "tag": { "type": "string", "minLength": 24, "maxLength": 24, "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
    "ciphertext": { "type": "string", "minLength": 1, "maxLength": 48000000, "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
  }
}
