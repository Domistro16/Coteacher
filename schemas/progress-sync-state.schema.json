{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coteacher.local/schemas/progress-sync-state.schema.json",
  "title": "ProgressSyncState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receipt",
    "eventIds",
    "questionIds"
  ],
  "properties": {
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "studentId",
        "lessonId",
        "recordingId",
        "sha256",
        "acceptedAt",
        "simulated"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "studentId": {
          "type": "string",
          "pattern": "^student-[a-f0-9]{8,32}$"
        },
        "lessonId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "recordingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "acceptedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "simulated": {
          "const": true
        }
      }
    },
    "eventIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "questionIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  }
}
