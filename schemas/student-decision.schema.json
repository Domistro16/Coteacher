{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "selectionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "learnerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "lessonId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "subjectKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "knowledgeKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "conceptId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "selectedVisualId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "basis": {
      "enum": [
        "explicit-choice",
        "observed",
        "signup",
        "default"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT.*Z$"
    },
    "simulated": {
      "const": true
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "1.0.0"
        },
        "modelVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "status": {
          "enum": [
            "estimate",
            "abstain"
          ]
        },
        "understanding": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "nextCheckProbability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "confidenceKind": {
          "enum": [
            "evidence-adequacy",
            "model-uncertainty"
          ]
        },
        "estimateKind": {
          "enum": [
            "response-evidence-proxy",
            "model-estimate"
          ]
        },
        "calibration": {
          "enum": [
            "unvalidated",
            "evaluated"
          ]
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "correctCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "abstainReason": {
          "enum": [
            "none",
            "personalization-off",
            "cold-start",
            "insufficient-evidence",
            "model-unavailable",
            "invalid-output"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "maxItems": 1000,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "modelVersion",
        "status",
        "understanding",
        "nextCheckProbability",
        "confidence",
        "confidenceKind",
        "estimateKind",
        "calibration",
        "sampleCount",
        "correctCount",
        "explanation",
        "abstainReason",
        "evidenceIds"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "maxItems": 20,
      "minItems": 1,
      "uniqueItems": true
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 250
      },
      "maxItems": 1000,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "selectionId",
    "learnerId",
    "lessonId",
    "subjectKey",
    "knowledgeKey",
    "conceptId",
    "selectedVisualId",
    "basis",
    "reason",
    "at",
    "simulated",
    "model",
    "sourceRefs",
    "evidenceIds"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coteacher.local/schemas/student-decision.schema.json",
  "title": "StudentDecision"
}
