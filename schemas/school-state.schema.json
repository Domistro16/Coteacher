            "type": "string"
          },
          "deleteAfter": {
            "type": "string"
          }
        },
        "required": [
          "key",
          "deleteAfter"
        ]
      }
    },
    "privateLearners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accountId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "envelope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "iv",
              "tag",
              "ciphertext"
            ],
            "properties": {
              "algorithm": {
                "const": "aes-256-gcm-server-v1"
              },
              "iv": {
                "type": "string",
                "minLength": 16,
                "maxLength": 16,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$"
              },
              "tag": {
                "type": "string",
                "minLength": 24,
                "maxLength": 24,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$"
              },
              "ciphertext": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48000000,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$"
              }
            }
          },
          "memoryEnvelope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "iv",
              "tag",
              "ciphertext"
            ],
            "properties": {
              "algorithm": {
                "const": "aes-256-gcm-server-v1"
              },
              "iv": {
                "type": "string",
                "minLength": 16,
                "maxLength": 16,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$"
              },
              "tag": {
                "type": "string",
                "minLength": 24,
                "maxLength": 24,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$"
              },
              "ciphertext": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48000000,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$"
              }
            }
          },
          "improvementExcludedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT.*Z$",
            "description": "Purpose-specific exclusion. Withdrawal and backup restore set this marker; only renewed explicit permission may clear it."
          },
          "improvementFeaturesEnvelope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "algorithm",
              "iv",
              "tag",
              "ciphertext"
            ],
            "properties": {
              "algorithm": {
                "const": "aes-256-gcm-server-v1"
              },
              "iv": {
                "type": "string",
                "minLength": 16,
                "maxLength": 16,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$"
              },
              "tag": {
                "type": "string",
                "minLength": 24,
                "maxLength": 24,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$"
              },
              "ciphertext": {
                "type": "string",
                "minLength": 1,
                "maxLength": 48000000,
                "pattern": "^[A-Za-z0-9+/]+={0,2}$"
              }
            },
            "description": "Reserved encrypted improvement-purpose derived features. No producer is enabled; withdrawal/restore remove this slot."
          },
          "improvementAuthorizationRequestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "Only this newly created guardian request can lift an active improvement exclusion. Withdrawal and restore remove the authorization."
          }
        },
        "required": [
          "accountId",
          "envelope"
        ]
      }
    },
    "preparedSupport": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "publicationId": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schemaVersion": {
                "const": "1.0.0"
              },
              "schoolId": {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              "lessonId": {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              "lessonRevision": {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              "sourceRevision": {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              "language": {
                "type": "string",
                "maxLength": 40,
                "minLength": 1
              },
              "configuration": {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "approved"
                ]
              },
              "reviewedAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT.*Z$"
              },
              "candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string",
                      "maxLength": 100,
                      "minLength": 1
                    },
                    "conceptId": {
                      "type": "string",
                      "maxLength": 100,
                      "minLength": 1
                    },
                    "question": {
                      "type": "string",
                      "maxLength": 800,
                      "minLength": 1
                    },
                    "answer": {
                      "type": "string",
                      "maxLength": 2000,
                      "minLength": 1
                    },
                    "sourceRefs": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 100,
                        "minLength": 1
                      },
                      "minItems": 1,
                      "maxItems": 20,
                      "uniqueItems": true
                    },
                    "rank": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "misconception": {
                      "type": "boolean"
                    },
                    "origin": {
                      "enum": [
                        "reviewed",
                        "generated"
                      ]
                    },
                    "quotes": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 6,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "sourceRef": {
                            "type": "string"
                          },
                          "variantId": {
                            "type": "string"
                          },
                          "quote": {
                            "type": "string",
                            "minLength": 12,
                            "maxLength": 2000
                          }
                        },
