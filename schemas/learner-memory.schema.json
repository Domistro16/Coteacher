{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "learnerId": {
      "type": "string",
      "maxLength": 100,
      "minLength": 1
    },
    "simulated": {
      "const": true
    },
    "consentRevision": {
      "type": "integer",
      "minimum": 0
    },
    "personalization": {
      "type": "boolean"
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "readingEase": {
          "type": "string",
          "enum": [
            "easy",
            "ok",
            "hard",
            "not-sure"
          ]
        },
        "formats": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "picture",
              "try-it",
              "steps",
              "example",
              "hearing"
            ]
          },
          "maxItems": 2,
          "uniqueItems": true
        },
        "length": {
          "type": "string",
          "enum": [
            "short",
            "detailed",
            "depends",
            "not-sure"
          ]
        },
        "medium": {
          "type": "string",
          "enum": [
            "listening",
            "reading",
            "both",
            "not-sure"
          ]
        },
        "largerText": {
          "type": "boolean"
        },
        "captions": {
          "type": "boolean"
        },
        "slowerAudio": {
          "type": "boolean"
        },
        "reducedMotion": {
          "type": "boolean"
        },
        "confidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subject": {
                "type": "string",
                "maxLength": 60,
                "minLength": 1
              },
              "rating": {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              }
            },
            "required": [
              "subject",
              "rating"
            ]
          },
          "maxItems": 15,
          "uniqueItems": true
        },
        "input": {
          "type": "string",
          "enum": [
            "speak",
            "type",
            "not-sure"
          ]
        },
        "feedback": {
          "type": "string",
          "enum": [
            "encouragement",
            "direct",
            "hints",
            "not-sure"
          ]
        }
      },
      "required": []
    },
    "evidence": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 250,
            "minLength": 1
          },
          "lessonId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "subjectKey": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "knowledgeKey": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT.*Z$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "assessment",
              "help",
              "choice"
            ]
          },
          "correct": {
            "type": "boolean"
          },
          "representation": {
            "type": "string",
            "enum": [
              "picture",
              "steps"
            ]
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true
          },
          "assessmentKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250,
            "description": "The assessed-content-v2 fingerprint sorts normalized options and identifies the correct answer by text. Order-sensitive v1 and absent keys remain rule evidence but are excluded from independent model assessment counts."
          }
        },
        "required": [
          "id",
          "lessonId",
          "subjectKey",
          "knowledgeKey",
          "at",
          "kind",
          "sourceRefs"
        ]
      }
    },
    "completedLessons": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lessonId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1
          },
          "completedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT.*Z$"
          }
        },
        "required": [
          "lessonId",
          "completedAt"
        ]
      }
    },
    "promptedLessons": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 100,
        "minLength": 1
      },
      "maxItems": 3,
      "uniqueItems": true
    },
    "clearedBefore": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT.*Z$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "const": "1.0.0"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "selectionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250,
            "description": "Identifier of the selection event; separate from supporting evidence identifiers."
          },
          "learnerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "lessonId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "subjectKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "knowledgeKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "conceptId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "selectedVisualId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "basis": {
            "enum": [
              "explicit-choice",
              "observed",
              "signup",
              "default"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d\\d-\\d\\dT.*Z$"
          },
          "simulated": {
            "const": true
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "schemaVersion": {
                "const": "1.0.0"
              },
              "modelVersion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "status": {
                "enum": [
                  "estimate",
                  "abstain"
                ]
              },
              "understanding": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "nextCheckProbability": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Evidence-adequacy confidence is bounded by n/(n+10) for the cited distinct assessments. Estimates require at least ten cited assessments regardless of confidence kind."
              },
              "confidenceKind": {
                "enum": [
                  "evidence-adequacy",
                  "model-uncertainty"
                ]
              },
              "estimateKind": {
                "enum": [
                  "response-evidence-proxy",
                  "model-estimate"
                ]
              },
              "calibration": {
                "enum": [
                  "unvalidated",
                  "evaluated"
                ]
              },
              "sampleCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "correctCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000,
                "description": "Number of correct outcomes among the cited eligible assessments, verified by the caller boundary."
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "abstainReason": {
                "enum": [
                  "none",
                  "personalization-off",
                  "cold-start",
                  "insufficient-evidence",
                  "model-unavailable",
                  "invalid-output"
                ]
              },
              "evidenceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 250
                },
                "maxItems": 1000,
                "uniqueItems": true
              }
            },
            "required": [
              "schemaVersion",
              "modelVersion",
              "status",
              "understanding",
              "nextCheckProbability",
              "confidence",
              "confidenceKind",
              "estimateKind",
              "calibration",
              "sampleCount",
              "correctCount",
              "explanation",
              "abstainReason",
              "evidenceIds"
            ],
            "if": {
              "properties": {
                "status": {
                  "const": "estimate"
                }
              }
            },
            "then": {
              "properties": {
                "sampleCount": {
                  "type": "integer",
                  "minimum": 10
                },
                "evidenceIds": {
                  "type": "array",
                  "minItems": 10
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0.5
                },
                "abstainReason": {
                  "const": "none"
                }
              }
            }
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "maxItems": 20,
            "minItems": 1,
            "uniqueItems": true
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 250
            },
            "maxItems": 1000,
            "uniqueItems": true,
            "description": "Prior evidence supporting the actual selected visual. Excludes the selectionId and its lesson-qualified event ID; empty for a selection without an observed-evidence basis."
          }
        },
        "required": [
          "schemaVersion",
          "id",
          "selectionId",
          "learnerId",
          "lessonId",
          "subjectKey",
          "knowledgeKey",
          "conceptId",
          "selectedVisualId",
          "basis",
          "reason",
          "at",
          "simulated",
          "model",
          "sourceRefs",
          "evidenceIds"
        ]
      },
      "maxItems": 1000
    }
  },
  "required": [
    "schemaVersion",
    "learnerId",
    "simulated",
    "consentRevision",
    "personalization",
    "preferences",
    "evidence",
    "completedLessons",
    "promptedLessons"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coteacher.local/schemas/learner-memory.schema.json",
  "title": "PrivateLearnerMemory"
}
