{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:coteacher:lesson-package:1.0.0",
  "title": "LessonPackage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "lessonId": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/text"
    },
    "subject": {
      "$ref": "#/$defs/text"
    },
    "topic": {
      "$ref": "#/$defs/text"
    },
    "classLevel": {
      "$ref": "#/$defs/text"
    },
    "contentOrigin": {
      "description": "This sprint uses only the supplied manually reviewed demo instruction. Collection and publication reject altered instruction even when approval and source identifiers are structurally valid.",
      "const": "manually-prepared-demo"
    },
    "publication": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "draft"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "approved"
            },
            "approvedAt": {
              "$ref": "#/$defs/timestamp"
            },
            "approvalKind": {
              "enum": [
                "teacher-review",
                "seeded-demo"
              ]
            }
          },
          "required": [
            "status",
            "approvedAt",
            "approvalKind"
          ]
        }
      ]
    },
    "language": {
      "$ref": "#/$defs/text"
    },
    "simulated": {
      "type": "boolean"
    },
    "studentId": {
      "$ref": "#/$defs/studentId"
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "conceptIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "text",
        "conceptIds"
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "concepts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/concept"
      },
      "minItems": 1
    },
    "timeline": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timelineStep"
      },
      "minItems": 1
    },
    "classroomTimeline": {
      "$ref": "#/$defs/classroomTimeline"
    },
    "recording": {
      "$ref": "#/$defs/lessonRecording"
    },
    "questionBank": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      },
      "minItems": 0
    },
    "quiz": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quizItem"
      },
      "minItems": 1
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conceptOrder": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "conceptRoutes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "conceptId": {
                "$ref": "#/$defs/id"
              },
              "variantOrder": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "reason": {
                "$ref": "#/$defs/text"
              }
            },
            "required": [
              "conceptId",
              "variantOrder",
              "reason"
            ]
          },
          "minItems": 1
        },
        "insertedRefreshers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "conceptId": {
                "$ref": "#/$defs/id"
              },
              "variantId": {
                "$ref": "#/$defs/id"
              },
              "beforeConceptId": {
                "$ref": "#/$defs/id"
              }
            },
            "required": [
              "conceptId",
              "variantId",
              "beforeConceptId"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "conceptOrder",
        "conceptRoutes",
        "insertedRefreshers"
      ]
    },
    "matcher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confidenceThreshold": {
          "$ref": "#/$defs/score"
        },
        "noMatchMessage": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "confidenceThreshold",
        "noMatchMessage"
      ]
    },
    "visualAssets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/visualAsset"
      },
      "minItems": 1,
      "maxItems": 20
    },
    "playback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordingId": {
          "$ref": "#/$defs/id"
        },
        "studentId": {
          "$ref": "#/$defs/studentId"
        },
        "simulated": {
          "const": true
        },
        "method": {
          "enum": [
            "demo-history-rules-v1",
            "prepared-support-rules-v2"
          ]
        },
        "catalogVersion": {
          "const": "refraction-visuals-v1"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sequence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cueIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 999
              },
              "offsetMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 21600000
              },
              "conceptId": {
                "$ref": "#/$defs/id"
              },
              "timelineStepId": {
                "$ref": "#/$defs/id"
              },
              "visualAssetId": {
                "$ref": "#/$defs/id"
              },
              "sourceRefs": {
                "$ref": "#/$defs/sourceRefs"
              }
            },
            "required": [
              "cueIndex",
              "offsetMs",
              "conceptId",
              "timelineStepId",
              "visualAssetId",
              "sourceRefs"
            ]
          }
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "difficulty": {
              "enum": [
                "boundary-position",
                "boundary-steps",
                "insufficient-history"
              ]
            },
            "preference": {
              "enum": [
                "concrete-diagrams",
                "ordered-annotations"
              ]
            },
            "representation": {
              "enum": [
                "concrete-diagrams",
                "ordered-annotations"
              ]
            },
            "basis": {
              "enum": [
                "simulated-history",
                "learner-preference",
                "default"
              ]
            }
          },
          "required": [
            "difficulty",
            "representation",
            "basis"
          ]
        }
      },
      "required": [
        "recordingId",
        "studentId",
        "simulated",
        "method",
        "catalogVersion",
        "reason",
        "sequence"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "lessonId",
    "title",
    "subject",
    "topic",
    "classLevel",
    "contentOrigin",
    "publication",
    "language",
    "simulated",
    "studentId",
    "objective",
    "sources",
    "concepts",
    "timeline",
    "questionBank",
    "quiz",
    "route",
    "matcher"
  ],
  "$defs": {
    "lessonRecording": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lessonId",
        "classroomSessionId",
        "lessonApprovedAt",
        "startedAt",
        "durationMs",
        "origin",
        "audio",
        "cues",
        "review"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "lessonId": {
          "$ref": "#/$defs/id"
        },
        "classroomSessionId": {
          "$ref": "#/$defs/id"
        },
        "lessonApprovedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 21600000
        },
        "origin": {
          "const": "teacher-microphone"
        },
        "audio": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mimeType",
                "sampleRate",
                "channels",
                "dataBase64"
              ],
              "properties": {
                "mimeType": {
                  "const": "audio/wav"
                },
                "sampleRate": {
                  "const": 16000
                },
                "channels": {
                  "const": 1
                },
                "dataBase64": {
                  "type": "string",
                  "minLength": 64,
                  "maxLength": 5120060,
                  "pattern": "^[A-Za-z0-9+/]+={0,2}$"
                },
                "mediaKey": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9+/]{43}=$"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sampleRate": {
                  "enum": [
                    16000,
                    48000
                  ]
                },
                "channels": {
                  "const": 1
                },
                "mediaKey": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9+/]{43}=$"
                },
                "mimeType": {
                  "const": "audio/ogg;codecs=opus"
                },
                "dataBase64": {
                  "type": "string",
                  "maxLength": 28000000,
                  "pattern": "^[A-Za-z0-9+/]+={0,2}$"
                }
              },
              "required": [
                "sampleRate",
                "channels",
                "mediaKey",
                "mimeType",
                "dataBase64"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sampleRate": {
                  "enum": [
                    16000,
                    48000
                  ]
                },
                "channels": {
                  "const": 1
                },
                "mediaKey": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9+/]{43}=$"
                },
                "mimeType": {
                  "enum": [
                    "audio/wav",
                    "audio/ogg;codecs=opus"
                  ]
                },
                "mediaId": {
                  "$ref": "#/$defs/id"
                },
                "byteLength": {
                  "type": "integer",
                  "minimum": 45,
                  "maximum": 20000000
                }
              },
              "required": [
                "sampleRate",
                "channels",
                "mediaKey",
                "mimeType",
                "mediaId",
                "byteLength"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sampleRate": {
                  "enum": [
                    16000,
                    48000
                  ]
                },
                "channels": {
                  "const": 1
                },
                "mediaKey": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9+/]{43}=$"
                },
                "mimeType": {
                  "enum": [
                    "audio/wav",
                    "audio/ogg;codecs=opus"
                  ]
                },
                "byteLength": {
                  "type": "integer",
                  "minimum": 45,
                  "maximum": 20000000
                },
                "mediaUrl": {
                  "type": "string",
                  "pattern": "^/api/recorded-lessons/[a-f0-9]{64}/audio\\?key=[a-f0-9]{64}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "sampleRate",
                "channels",
                "mediaKey",
                "mimeType",
                "byteLength",
                "mediaUrl",
                "sha256"
              ]
            }
          ]
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "offsetMs",
              "timelineStepId",
              "conceptId",
              "sourceRefs"
            ],
            "properties": {
              "offsetMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 21600000
              },
              "timelineStepId": {
                "$ref": "#/$defs/id"
              },
              "conceptId": {
                "$ref": "#/$defs/id"
              },
              "sourceRefs": {
                "$ref": "#/$defs/sourceRefs"
              }
            }
          }
        },
        "review": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "const": "draft"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reviewedAt"
              ],
              "properties": {
                "status": {
                  "const": "approved"
                },
                "reviewedAt": {
                  "$ref": "#/$defs/timestamp"
                }
              }
            }
          ]
        },
        "visualReview": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "const": "draft"
                }
              },
              "required": [
                "status"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "status": {
                  "const": "approved"
                },
                "reviewedAt": {
                  "$ref": "#/$defs/timestamp"
                },
                "catalogVersion": {
                  "const": "refraction-visuals-v1"
                }
              },
              "required": [
                "status",
                "reviewedAt",
                "catalogVersion"
              ]
            }
          ]
        }
      }
    },
    "classroomTimeline": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionId": {
          "$ref": "#/$defs/id"
        },
        "approvedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "currentStepId": {
          "$ref": "#/$defs/id"
        },
        "visits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "timelineStepId": {
                "$ref": "#/$defs/id"
              },
              "conceptId": {
                "$ref": "#/$defs/id"
              },
              "presentedAt": {
                "$ref": "#/$defs/timestamp"
              }
            },
            "required": [
              "timelineStepId",
              "conceptId",
              "presentedAt"
            ]
          }
        }
      },
      "required": [
        "sessionId",
        "approvedAt",
        "startedAt",
        "currentStepId",
        "visits"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "studentId": {
      "type": "string",
      "pattern": "^student-[0-9a-f]{8,32}$"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "assetPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.[A-Za-z0-9]+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "enum": [
            "notes",
            "textbook",
            "reference"
          ]
        },
        "citation": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "citation"
      ]
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "prerequisiteConceptIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "misconceptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 0
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant"
          },
          "minItems": 2
        }
      },
      "required": [
        "id",
        "title",
        "prerequisiteConceptIds",
        "misconceptions",
        "sourceRefs",
        "variants"
      ]
    },
    "variant": {
      "oneOf": [
        {
          "$ref": "#/$defs/explanationVariant"
        },
        {
          "$ref": "#/$defs/tryItVariant"
        }
      ]
    },
    "explanationVariant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "original",
            "short",
            "analogy",
            "stepwise",
            "refresher"
          ]
        },
        "content": {
          "$ref": "#/$defs/text"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "visualAssetPath": {
          "$ref": "#/$defs/assetPath"
        },
        "audioAssetPath": {
          "$ref": "#/$defs/assetPath"
        }
      },
      "required": [
        "id",
        "type",
        "content",
        "sourceRefs"
      ]
    },
    "tryItVariant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "tryit"
        },
        "content": {
          "$ref": "#/$defs/text"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "visualAssetPath": {
          "$ref": "#/$defs/assetPath"
        },
        "audioAssetPath": {
          "$ref": "#/$defs/assetPath"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1
        },
        "explainsWhy": {
          "$ref": "#/$defs/text"
        },
        "safetyNotes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1
        },
        "returnToStep": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "type",
        "content",
        "sourceRefs",
        "items",
        "steps",
        "explainsWhy",
        "safetyNotes",
        "returnToStep"
      ]
    },
    "timelineStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "conceptId": {
          "$ref": "#/$defs/id"
        },
        "teacherSaid": {
          "$ref": "#/$defs/text"
        },
        "defaultVariantId": {
          "$ref": "#/$defs/id"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      },
      "required": [
        "id",
        "conceptId",
        "teacherSaid",
        "defaultVariantId",
        "sourceRefs"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "$ref": "#/$defs/text"
        },
        "alternatePhrasings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "answer": {
          "$ref": "#/$defs/text"
        },
        "conceptId": {
          "$ref": "#/$defs/id"
        },
        "timelineStepId": {
          "$ref": "#/$defs/id"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "audience": {
          "enum": [
            "class",
            "student"
          ]
        }
      },
      "required": [
        "id",
        "question",
        "alternatePhrasings",
        "answer",
        "conceptId",
        "timelineStepId",
        "sourceRefs",
        "audience"
      ]
    },
    "quizItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "correctIndex": {
          "type": "integer",
          "minimum": 0
        },
        "explanation": {
          "$ref": "#/$defs/text"
        },
        "conceptId": {
          "$ref": "#/$defs/id"
        },
        "misconception": {
          "$ref": "#/$defs/text"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        }
      },
      "required": [
        "id",
        "prompt",
        "options",
        "correctIndex",
        "explanation",
        "conceptId",
        "misconception",
        "sourceRefs"
      ]
    },
    "visualLayer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "path",
            "rect",
            "circle",
            "text"
          ]
        },
