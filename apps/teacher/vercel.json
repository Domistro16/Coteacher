{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build --workspace @coteacher/teacher",
  "outputDirectory": "apps/teacher/dist",
  "functions": { "api/proxy.ts": { "maxDuration": 120 } },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/proxy?path=:path*" }, { "source": "/((?!api/).*)", "destination": "/index.html" }]
}
